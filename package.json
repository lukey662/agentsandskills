{
  "name": "@appsforgood/next-supabase-kit",
  "version": "0.5.0",
  "description": "Agents, skills, and a user guide for Next.js and Supabase projects. QA reviews screenshots, not code alone.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukey662/agentsandskills.git"
  },
  "bugs": {
    "url": "https://github.com/lukey662/agentsandskills/issues"
  },
  "homepage": "https://github.com/lukey662/agentsandskills#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "bin": {
    "agent-kit": "dist/index.js",
    "agents-and-skills": "dist/index.js"
  },
  "files": [
    "dist",
    "catalog.json",
    "templates/next-supabase/AGENTS.md",
    "templates/next-supabase/CLAUDE.md",
    "agents",
    "skills",
    "templates/next-supabase/.cursor/rules/cursor-agent-kit.mdc",
    "USER_GUIDE.md",
    "USER_GUIDE.html",
    "examples/next-supabase-installed",
    "research/agent-skill-gap-report.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SUPPORT.md",
    "LICENSE",
    "SECURITY.md",
    "UPGRADE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "node dist/index.js doctor",
    "smoke:install": "node scripts/smoke-install.mjs",
    "smoke:audit-gate": "node scripts/smoke-audit-gate.mjs",
    "smoke:ui-screens": "node scripts/smoke-ui-screens.mjs",
    "package:validate": "node dist/index.js package validate",
    "examples:check": "node scripts/example-check.mjs",
    "examples:refresh": "node scripts/refresh-examples.mjs",
    "version:check": "node scripts/version-check.mjs",
    "sbom:check": "node scripts/sbom-check.mjs",
    "sbom:generate": "node scripts/sbom-check.mjs --output sbom.cdx.json",
    "publish:verify": "node scripts/post-publish-verify.mjs",
    "changeset": "changeset",
    "changeset:check": "node scripts/version-packages.mjs --check",
    "changeset:version": "node scripts/version-packages.mjs",
    "release:check": "node scripts/release-check.mjs",
    "pack:check": "npm pack --dry-run",
    "dogfood:init": "node scripts/dogfood-init.mjs",
    "dogfood:check": "tsx scripts/dogfood-check.ts",
    "adapter:validate": "node scripts/adapter-validate-example.mjs"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "@appsforgood/agent-kit-runtime": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@appsforgood/agent-kit-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "playwright": "^1.55.1",
    "prettier": "^3.9.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
