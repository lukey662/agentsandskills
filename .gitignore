# Maintainer dogfood: this repo installs its own kit. Rendered IDE layers stay local and are
# regenerated by `npm run dogfood:check`. The Cursor rule, CLAUDE.md, and
# .github/copilot-instructions.md are tracked because they are generated files a reader sees.
.cursor/*
!.cursor/rules/
/.agents/
/.claude/
/.codex/
/.github/agents/
.agent-kit/conflicts/

# The example fixture is the one place rendered IDE files are committed.
!examples/next-supabase-installed/.cursor/
!examples/next-supabase-installed/.cursor/**
!examples/next-supabase-installed/.agents/
!examples/next-supabase-installed/.agents/**
!examples/next-supabase-installed/.claude/
!examples/next-supabase-installed/.claude/**
!examples/next-supabase-installed/.codex/
!examples/next-supabase-installed/.codex/**
!examples/next-supabase-installed/.github/
!examples/next-supabase-installed/.github/**
